    },
    {
      "id": "media_items",
      "label": "media_items",
      "tag": "media",
      "row": 0,
      "col": 2,
      "attributes": [
        { "name": "id", "type": "integer", "key": "pk" },
        { "name": "series_id", "type": "integer", "key": "fk", "references": "series.id" },
        { "name": "configuration_id", "type": "integer", "key": "fk", "references": "configurations.id" },
