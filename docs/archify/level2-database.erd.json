        { "name": "entrance_kind", "type": "text" },
        { "name": "terrace_type", "type": "text" },
        { "name": "kind", "type": "text" },
        { "name": "url", "type": "text" }
      ]
    }
  ],
  "relationships": [
    {
      "id": "orders_users",
      "from": "orders",
      "to": "users",
      "label": "принадлежит",
      "fromCardinality": "many",
      "fromOptional": true,
      "toCardinality": "one"
    },
    {
      "id": "series_categories",
      "from": "series",
      "to": "categories",
      "label": "входит в",
      "fromCardinality": "many",
      "toCardinality": "one"
    },
    {
      "id": "configurations_series",
      "from": "configurations",
      "to": "series",
      "label": "габариты",
      "fromCardinality": "many",
      "toCardinality": "one"
    },
    {
      "id": "media_series",
      "from": "media_items",
      "to": "series",
      "label": "галерея",
      "fromCardinality": "many",
      "toCardinality": "one"
    },
    {
      "id": "media_config",
      "from": "media_items",
      "to": "configurations",
      "label": "размер фото",
      "fromCardinality": "many",
      "fromOptional": true,
      "toCardinality": "one"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Схема каталога и медиатеки",
      "items": [
        "categories (1) -> series (N) -> configurations (N): иерархия проектов",
        "media_items хранит пути к реальным файлам с привязкой к цвету, ракурсу и пристрою"
      ]
    },
    {
      "dot": "cyan",
      "title": "Связка пользователей и заказов",
      "items": [
        "orders.user_id ссылается на users.id (опционально для старых гостевых заказов)",
        "При регистрации по номеру телефона заказы связываются автоматически"
      ]
    }
  ]
}
