      "row": 1,
      "col": 2,
      "attributes": [
        { "name": "id", "type": "integer", "key": "pk" },
        { "name": "series_id", "type": "integer", "key": "fk", "references": "series.id" },
        { "name": "key", "type": "text" },
        { "name": "label", "type": "text" },
        { "name": "area", "type": "real" },
        { "name": "price", "type": "integer" },
        { "name": "folder_name", "type": "text" }
