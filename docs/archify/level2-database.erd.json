        { "name": "email", "type": "text", "key": "uk" },
        { "name": "phone", "type": "text" },
        { "name": "name", "type": "text" },
        { "name": "password_hash", "type": "text" },
        { "name": "role", "type": "text" },
        { "name": "created_at", "type": "datetime" }
      ]
    },
    {
      "id": "orders",
      "label": "orders",
      "tag": "sales",
      "row": 0,
      "col": 1,
      "width": 260,
      "attributes": [
        { "name": "id", "type": "integer", "key": "pk" },
        { "name": "order_number", "type": "text", "key": "uk" },
        { "name": "user_id", "type": "integer", "key": "fk", "references": "users.id" },
        { "name": "customer_name", "type": "text" },
        { "name": "customer_phone", "type": "text" },
        { "name": "items_json", "type": "text" },
        { "name": "total_price", "type": "integer" },
        { "name": "payment_status", "type": "text" },
        { "name": "status", "type": "text" }
      ]
    },
    {
      "id": "categories",
      "label": "categories",
      "tag": "catalog",
      "row": 1,
      "col": 0,
      "attributes": [
        { "name": "id", "type": "integer", "key": "pk" },
        { "name": "name", "type": "text" },
        { "name": "slug", "type": "text", "key": "uk" },
        { "name": "sort_order", "type": "integer" }
      ]
    },
    {
      "id": "series",
      "label": "series",
      "tag": "catalog",
      "row": 1,
      "col": 1,
      "attributes": [
        { "name": "id", "type": "integer", "key": "pk" },
        { "name": "category_id", "type": "integer", "key": "fk", "references": "categories.id" },
        { "name": "name", "type": "text" },
        { "name": "slug", "type": "text", "key": "uk" },
        { "name": "base_price", "type": "integer" },
        { "name": "cover_image", "type": "text" },
        { "name": "is_active", "type": "integer" }
